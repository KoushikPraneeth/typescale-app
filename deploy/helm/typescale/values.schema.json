{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "namespacePrefix", "service", "publicService", "metrics", "autoscaling", "podSecurityContext", "containerSecurityContext", "startupProbe", "readinessProbe", "livenessProbe", "resources"],
      "allOf": [
        {
          "if": {
            "properties": {
              "autoscaling": {
                "properties": {"enabled": {"const": true}}
              }
            }
          },
          "then": {
            "properties": {
              "metrics": {
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      ],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"},
        "namespacePrefix": {"type": "string"},
        "service": {"$ref": "#/definitions/service"},
        "publicService": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "type", "port"],
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"type": "string", "enum": ["LoadBalancer", "NodePort", "ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path", "port", "allowedNamespace"],
          "properties": {
            "enabled": {"type": "boolean"},
            "path": {"type": "string", "pattern": "^/"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "allowedNamespace": {"type": "string", "minLength": 1, "maxLength": 63}
          }
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minReplicaCount", "maxReplicaCount", "pollingInterval", "cooldownPeriod", "fallback", "prometheus"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicaCount": {"type": "integer", "minimum": 1},
            "maxReplicaCount": {"type": "integer", "minimum": 1},
            "pollingInterval": {"type": "integer", "minimum": 1},
            "cooldownPeriod": {"type": "integer", "minimum": 0},
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "required": ["failureThreshold", "replicas", "behavior"],
              "properties": {
                "failureThreshold": {"type": "integer", "minimum": 1},
                "replicas": {"type": "integer", "minimum": 1},
                "behavior": {"type": "string", "enum": ["static", "currentReplicas"]}
              }
            },
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["serverAddress", "jobName", "query", "threshold", "activationThreshold"],
              "properties": {
                "serverAddress": {"type": "string", "pattern": "^https?://"},
                "jobName": {"type": "string", "minLength": 1},
                "query": {"type": "string"},
                "threshold": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "activationThreshold": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
              }
            }
          }
        },
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "startupProbe": {"$ref": "#/definitions/startupProbe"},
        "readinessProbe": {"$ref": "#/definitions/periodicProbe"},
        "livenessProbe": {"$ref": "#/definitions/periodicProbe"},
        "resources": {"type": "object"}
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "service", "podSecurityContext", "containerSecurityContext", "readinessProbe", "livenessProbe", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "const": 1},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "readinessProbe": {"$ref": "#/definitions/execProbe"},
        "livenessProbe": {"$ref": "#/definitions/execProbe"},
        "resources": {"type": "object"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "required": ["app", "redis", "networkPolicy"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "periodicProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds"],
      "properties": {"periodSeconds": {"type": "integer", "minimum": 1}}
    },
    "startupProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "execProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds"],
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
