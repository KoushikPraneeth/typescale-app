{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "namespacePrefix", "service", "publicService", "podSecurityContext", "containerSecurityContext", "startupProbe", "readinessProbe", "livenessProbe", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"},
        "namespacePrefix": {"type": "string"},
        "service": {"$ref": "#/definitions/service"},
        "publicService": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "type", "port"],
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"type": "string", "enum": ["LoadBalancer", "NodePort", "ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "startupProbe": {"$ref": "#/definitions/startupProbe"},
        "readinessProbe": {"$ref": "#/definitions/periodicProbe"},
        "livenessProbe": {"$ref": "#/definitions/periodicProbe"},
        "resources": {"type": "object"}
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "service", "podSecurityContext", "containerSecurityContext", "readinessProbe", "livenessProbe", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "const": 1},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "readinessProbe": {"$ref": "#/definitions/execProbe"},
        "livenessProbe": {"$ref": "#/definitions/execProbe"},
        "resources": {"type": "object"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "required": ["app", "redis", "networkPolicy"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "periodicProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds"],
      "properties": {"periodSeconds": {"type": "integer", "minimum": 1}}
    },
    "startupProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "execProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds"],
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
